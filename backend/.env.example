# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Any long random string. Used to sign session cookies (JWT).
# On Render, set this once in the dashboard and NEVER change it (changing it logs everyone out).
JWT_SECRET=replace-this-with-a-long-random-string

# Optional — Render sets this automatically. Defaults to 3000 locally.
PORT=3000

# Set to "production" when deployed (enables secure cookies).
NODE_ENV=development

# Where data.json (accounts, menu, orders, sales) is stored.
# Local: leave unset (uses backend/data.json).
# Render: set to the mount path of your Persistent Disk, e.g. /var/data
# DATA_DIR=/var/data

# Optional — the public address encoded in table QR codes, e.g. https://eastern-gate.onrender.com
# If unset, the address you are visiting the admin page from is used.
# PUBLIC_BASE_URL=https://your-site.onrender.com
